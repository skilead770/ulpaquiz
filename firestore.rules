rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data model: students/{id} contains private identity, status, and quiz data;
    // publicStudents/{id} contains only approved leaderboard fields; managers/{id}
    // contains verified manager identity; settings/{id}, halachot/{id}, and
    // invitations/{id} are shared application configuration/content.
    // Private student and manager records are limited to managers and the
    // matching verified account. Public leaderboard records omit account
    // identifiers and answers, and are matched to their private record on write.
    
    // Manager document IDs are normalized from lowercase email addresses.
    // Also accept the legacy super_admin document when its stored email matches.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        (
          (
            exists(/databases/$(database)/documents/managers/$(request.auth.token.email.lower().replace("[^a-zA-Z0-9_]", "_"))) &&
            get(/databases/$(database)/documents/managers/$(request.auth.token.email.lower().replace("[^a-zA-Z0-9_]", "_"))).data.email is string &&
            get(/databases/$(database)/documents/managers/$(request.auth.token.email.lower().replace("[^a-zA-Z0-9_]", "_"))).data.email.lower() == request.auth.token.email.lower()
          ) ||
          (
            exists(/databases/$(database)/documents/managers/super_admin) &&
            get(/databases/$(database)/documents/managers/super_admin).data.email is string &&
            get(/databases/$(database)/documents/managers/super_admin).data.email.lower() == request.auth.token.email.lower()
          )
        );
    }
    
    // Student ownership is based on the verified Firebase Auth email, not a client-supplied ID.
    // Keep the check stable and case-insensitive to avoid rejecting valid Gmail-based updates.
    function isOwner(studentId) {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        resource.data.email is string &&
        request.auth.token.email.lower() == resource.data.email.lower() &&
        studentId == resource.data.id &&
        resource.data.status == 'approved';
    }

    function isStudentRecordOwner() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        resource.data.email is string &&
        request.auth.token.email == resource.data.email;
    }

    function hasMatchingPublicSummary(studentId) {
      let privatePath = /databases/$(database)/documents/students/$(studentId);
      let student = getAfter(privatePath).data;
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        existsAfter(privatePath) &&
        student.status == 'approved' &&
        (!('managerParticipation' in student) || student.managerParticipation != true) &&
        studentId == student.id &&
        request.auth.token.email == student.email &&
        request.resource.data.id == student.id &&
        request.resource.data.fullName == student.fullName &&
        request.resource.data.className == student.className &&
        request.resource.data.grade == student.grade &&
        request.resource.data.points == student.points &&
        request.resource.data.completedDates == student.completedDates;
    }

    function isValidPublicStudentSummary(data) {
      return data.keys().hasAll([
          'id', 'fullName', 'className', 'grade', 'points', 'completedDates'
        ]) &&
        data.keys().hasOnly([
          'id', 'fullName', 'className', 'grade', 'points', 'completedDates'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 150 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
        data.className is string && data.className.size() > 0 && data.className.size() <= 40 &&
        data.grade in ['ט', 'י', 'יא', 'יב'] &&
        data.points is int && data.points >= 0 && data.points <= 1000000 &&
        data.completedDates is list && data.completedDates.size() <= 400;
    }

    function isValidStudentDocument(data) {
      return data.keys().hasAll([
          'id', 'fullName', 'className', 'grade', 'username', 'points',
          'completedDates', 'submissions'
        ]) &&
        data.keys().hasOnly([
          'id', 'fullName', 'className', 'grade', 'username', 'email',
          'password', 'points', 'completedDates', 'submissions', 'status',
          'registeredAt', 'invitationCode', 'managerParticipation'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 150 &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
        data.className is string && data.className.size() > 0 && data.className.size() <= 40 &&
        data.grade in ['ט', 'י', 'יא', 'יב'] &&
        data.username is string && data.username.size() > 0 && data.username.size() <= 64 &&
        data.points is int && data.points >= 0 && data.points <= 1000000 &&
        data.completedDates is list && data.completedDates.size() <= 400 &&
        data.submissions is map && data.submissions.size() <= 400 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
        (!('password' in data) || (data.password is string && data.password.size() <= 100)) &&
        (!('status' in data) || data.status in ['approved', 'pending', 'rejected']) &&
        (!('registeredAt' in data) || (data.registeredAt is string && data.registeredAt.size() <= 40)) &&
        (!('invitationCode' in data) || (data.invitationCode is string && data.invitationCode.size() <= 64)) &&
        (!('managerParticipation' in data) || data.managerParticipation == true);
    }

    function isValidPendingRegistration(data) {
      return isValidStudentDocument(data) &&
        data.keys().hasAll(['email', 'status']) &&
        data.email is string && data.email.matches("^[A-Za-z0-9._%+-]+@gmail\\.com$") &&
        data.id == ("s-reg-" + data.email.lower().replace("[^a-zA-Z0-9_]", "_")) &&
        data.status == 'pending' &&
        data.points == 0 &&
        data.completedDates.size() == 0 &&
        data.submissions.size() == 0 &&
        !('password' in data);
    }

    function dateMatchesTimestamp(date, time) {
      let parts = date.split('-');
      return date is string &&
        date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        int(parts[0]) == time.year() &&
        int(parts[1]) == time.month() &&
        int(parts[2]) == time.day();
    }

    function isCurrentJerusalemDate(date) {
      return dateMatchesTimestamp(date, request.time + duration.value(2, 'h')) ||
        dateMatchesTimestamp(date, request.time + duration.value(3, 'h'));
    }

    function hasValidQuizAnswers(questions, answers, score) {
      let q1 = questions[0];
      let q2 = questions[1];
      let q3 = questions[2];
      let q4 = questions[3];
      let correctCount =
        (answers[q1.id] == q1.correctOptionIndex ? 1 : 0) +
        (answers[q2.id] == q2.correctOptionIndex ? 1 : 0) +
        (answers[q3.id] == q3.correctOptionIndex ? 1 : 0) +
        (answers[q4.id] == q4.correctOptionIndex ? 1 : 0);

      return questions is list && questions.size() == 4 &&
        answers is map && answers.size() == 4 &&
        answers.keys().hasOnly([q1.id, q2.id, q3.id, q4.id]) &&
        answers.keys().hasAll([q1.id, q2.id, q3.id, q4.id]) &&
        answers[q1.id] is int && answers[q1.id] >= 0 && answers[q1.id] <= 3 &&
        answers[q2.id] is int && answers[q2.id] >= 0 && answers[q2.id] <= 3 &&
        answers[q3.id] is int && answers[q3.id] >= 0 && answers[q3.id] <= 3 &&
        answers[q4.id] is int && answers[q4.id] >= 0 && answers[q4.id] <= 3 &&
        q1.correctOptionIndex is int && q1.correctOptionIndex >= 0 && q1.correctOptionIndex <= 3 &&
        q2.correctOptionIndex is int && q2.correctOptionIndex >= 0 && q2.correctOptionIndex <= 3 &&
        q3.correctOptionIndex is int && q3.correctOptionIndex >= 0 && q3.correctOptionIndex <= 3 &&
        q4.correctOptionIndex is int && q4.correctOptionIndex >= 0 && q4.correctOptionIndex <= 3 &&
        score == correctCount;
    }

    function isValidQuizSubmission(date) {
      let submission = request.resource.data.submissions[date];
      let quizPath = /databases/$(database)/documents/halachot/$(submission.halachaId);
      let quiz = get(quizPath).data;
      let studyPoints = ('confirmedStudy' in submission && submission.confirmedStudy == true) ? 10 : 0;
      let questionPoints = submission.score * 10;
      let bonusPoints = (submission.score == 4 ? 20 : 0);
      let expectedEarned = studyPoints + questionPoints + bonusPoints;

      return isCurrentJerusalemDate(date) &&
        submission is map &&
        submission.keys().hasOnly(['date', 'halachaId', 'score', 'earnedPoints', 'submittedAt', 'answers', 'confirmedStudy']) &&
        submission.date == date &&
        submission.halachaId is string && submission.halachaId.size() <= 150 &&
        quiz.date == date &&
        (!('quizEnabled' in quiz) || quiz.quizEnabled == true) &&
        quiz.questions is list && quiz.questions.size() == 4 &&
        submission.score is int && submission.score >= 0 && submission.score <= 4 &&
        submission.earnedPoints is int &&
        (submission.earnedPoints == expectedEarned || submission.earnedPoints == (submission.score == 4 ? 2 : 1)) &&
        (!('confirmedStudy' in submission) || submission.confirmedStudy is bool) &&
        submission.submittedAt is string && submission.submittedAt.size() <= 32 &&
        hasValidQuizAnswers(quiz.questions, submission.answers, submission.score);
    }

    // Student quiz submission: approved owner can add a new daily submission and increase points.
    function isValidQuizProgressUpdate(studentId) {
      let previousDates = resource.data.completedDates;
      let newDates = request.resource.data.completedDates;
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let newDate = newDates[newDates.size() - 1];
      let newSubmission = request.resource.data.submissions[newDate];

      return isOwner(studentId) &&
        isValidStudentDocument(request.resource.data) &&
        affectedKeys.hasOnly(['points', 'completedDates', 'submissions']) &&
        affectedKeys.hasAll(['points', 'completedDates', 'submissions']) &&
        newDates.size() == previousDates.size() + 1 &&
        newDates.hasAll(previousDates) &&
        newDate is string &&
        !previousDates.hasAny([newDate]) &&
        newSubmission is map &&
        newSubmission.date == newDate &&
        newSubmission.score is int &&
        newSubmission.score >= 0 && newSubmission.score <= 4 &&
        newSubmission.earnedPoints is int &&
        request.resource.data.points >= resource.data.points &&
        request.resource.data.points == resource.data.points + newSubmission.earnedPoints &&
        request.resource.data.submissions[newDate].date == newDate;
    }

    // Admin reset: manager can revoke a previous quiz submission and reduce the student's points.
    function isValidAdminResetScore(studentId) {
      let submissionDelta = request.resource.data.submissions.diff(resource.data.submissions);
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return isAdmin() &&
        resource.data.id == studentId &&
        resource.data.email is string &&
        resource.data.status == 'approved' &&
        affectedKeys.hasOnly(['points', 'completedDates', 'submissions']) &&
        affectedKeys.hasAll(['points', 'completedDates', 'submissions']) &&
        request.resource.data.points <= resource.data.points &&
        request.resource.data.completedDates.size() <= resource.data.completedDates.size() &&
        submissionDelta.removedKeys().size() >= 1 &&
        request.resource.data.submissions.size() <= resource.data.submissions.size();
    }

    function isAdminApproval(studentId) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.id == studentId &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'approved' &&
        affectedKeys.hasOnly(['status']) &&
        affectedKeys.hasAll(['status']);
    }

    // 1. Halachot & Quizzes: Publicly readable for students, Admin-only write
    match /halachot/{halachaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 2. Invitations: Publicly readable for validation during registration, Admin-only write
    match /invitations/{invId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 3. Managers: Admin-only read/write
    match /managers/{managerId} {
      allow read: if isAdmin() ||
        (request.auth != null &&
          request.auth.token.email_verified == true &&
          request.auth.token.email is string &&
          resource.data.email is string &&
          request.auth.token.email == resource.data.email);
      allow write: if isAdmin();
    }
    
    // 4. Settings: Publicly readable, Admin-only write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 5. Students: 
    match /students/{studentId} {
      allow read: if isAdmin() || isStudentRecordOwner();
      
      // Keep pending registration public, but reject extra fields or privilege data.
      allow create: if (isAdmin() && isValidStudentDocument(request.resource.data)) ||
        isValidPendingRegistration(request.resource.data);
      
      // Allow updates for quiz submissions and admin reset actions.
      // Restricted to owners OR admins, with explicit handling for legitimate reset flows.
      allow update: if (isAdmin() &&
          (isValidStudentDocument(request.resource.data) || isAdminApproval(studentId))) ||
        isValidQuizProgressUpdate(studentId) ||
        isValidAdminResetScore(studentId);
      
      // Prevent public deletion
      allow delete: if isAdmin();
    }

    // Public leaderboard profile contains no email, username, or quiz answers.
    match /publicStudents/{studentId} {
      allow read: if true;
      allow create, update: if isValidPublicStudentSummary(request.resource.data) &&
        request.resource.data.id == studentId &&
        (isAdmin() || hasMatchingPublicSummary(studentId));
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
