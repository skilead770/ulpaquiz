{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:firebase": "vite build",
    "build:staging": "vite build --mode staging",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "firebase:login": "npx firebase-tools login --no-localhost",
    "deploy:hosting": "npm run build:firebase && npx firebase-tools deploy --only hosting --project ulpaquiz",
    "deploy:staging": "npm run build:staging && npx firebase-tools deploy --only hosting --project staging",
    "deploy:staging:firestore": "npx firebase-tools deploy --only firestore --project staging",
    "deploy:prod": "npm run build:firebase && npx firebase-tools deploy --only hosting --project prod",
    "deploy:prod:rules": "npx firebase-tools deploy --only firestore:rules --project prod",
    "deploy:prod:firestore": "npx firebase-tools deploy --only firestore --project prod"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hebcal/core": "^6.9.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.3",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
