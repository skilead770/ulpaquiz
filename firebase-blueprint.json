{
  "entities": {
    "students": {
      "title": "Students",
      "description": "Registered students participating in the daily halacha program",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "className": { "type": "string" },
        "grade": { "type": "string", "enum": ["ט", "י", "יא", "יב"] },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "points": { "type": "number" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "registeredAt": { "type": "string" },
        "invitationCode": { "type": "string" },
        "completedDates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "submissions": { "type": "object" }
      },
      "required": ["id", "fullName", "className", "grade", "points"]
    },
    "halachot": {
      "title": "Daily Halachot",
      "description": "Daily halacha content and quizzes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "source": { "type": "string" },
        "content": { "type": "string" },
        "questions": { "type": "array" }
      },
      "required": ["id", "date", "title", "content", "questions"]
    },
    "invitations": {
      "title": "Class & Student Invitations",
      "description": "Invitation codes generated by admins for student onboarding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "className": { "type": "string" },
        "grade": { "type": "string" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "code", "className", "grade"]
    }
  }
}
